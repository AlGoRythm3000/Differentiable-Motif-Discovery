full_environment.yml

# ignore Python bytecode files and cache directories
__pycache__/
.pytest_cache/
*.pyc
models/__pycache__/
tasks/__pycache__/
tests/__pycache__/
tools/__pycache__/

# ignore virtual environment directories
venv/
*.egg-info/

# ignore downloaded/cached datasets (auto-fetched by TUDataset etc.)
datasets/

# ignore the pretrained GPSE checkpoint (~254MB, fetched by ./download_gpse.sh)
# and any local GPSE encoding cache written by tools/gpse_cache.py, but keep
# GPSE_pretrained/README.md documenting the expected layout.
GPSE_pretrained/*.pt
*.gpse_cache.pt

# Experiment outputs: ignore the run/analysis artefacts, but keep the analysis
# SCRIPTS tracked - tests/test_analyze_*.py import them as `results.analyze_*`,
# and the final report is built from what they produce.
results/*
!results/*.py

# the paper (draft, notes, bibliography pdfs, latex build) stays out of git
paper/
papiers_bibliographie/
